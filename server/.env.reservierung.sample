# .env für den Reservierungs-Voice-Agent (Kopie als .env speichern, niemals committen)

# Microsoft Foundry Ressource (Voice Live). Werte aus dem Azure-Portal oder per az cognitiveservices account show / keys list.
AZURE_VOICE_LIVE_ENDPOINT=<https://<ressourcenname>.services.ai.azure.com/ oder .cognitiveservices.azure.com/>
AZURE_VOICE_LIVE_API_KEY=<Key der Foundry-Ressource>

# Generatives Modell für Voice Live. gpt-4.1-mini und gpt-5-mini sind in allen Voice-Live-Regionen verfügbar.
VOICE_LIVE_MODEL=gpt-4.1-mini

# Stimme
# azure-standard: Azure-Standardstimme, VOICE_NAME z. B. de-AT-JonasNeural oder de-AT-IngridNeural
# azure-personal: nachgebildete Stimme (Personal Voice, Limited Access). VOICE_NAME = Name der Personal Voice auf derselben Foundry-Ressource,
#                 VOICE_MODEL = DragonLatestNeural (höchste Ähnlichkeit) oder DragonHDOmniLatestNeural (natürlichere Prosodie)
VOICE_TYPE=azure-standard
VOICE_NAME=de-AT-JonasNeural
VOICE_MODEL=DragonLatestNeural

# Prompt und Auftragsdaten
PROMPT_FILE=prompts/reservierungsagent.txt
RESERVATION_FILE=reservation.json

# Nur für Telefonie über Azure Communication Services (nicht für den Browser-Test nötig)
ACS_CONNECTION_STRING=
ACS_DEV_TUNNEL=

# Hintergrundgeräusche für Robustheitstests: none, office, call_center
AMBIENT_PRESET=none
